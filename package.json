{
  "name": "tdd-mcp-server",
  "version": "2.1.0",
  "description": "Test Driven Development MCP Server - Provides TDD workflow support for AI tools",
  "type": "module",
  "main": "dist/server.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "node --max-old-space-size=2048 node_modules/jest/bin/jest.js --maxWorkers=2 --workerIdleMemoryLimit=512MB",
    "test:esm": "node --max-old-space-size=2048 --experimental-vm-modules node_modules/jest/bin/jest.js --maxWorkers=2 --workerIdleMemoryLimit=512MB",
    "test:watch": "node --max-old-space-size=2048 node_modules/jest/bin/jest.js --watch --maxWorkers=2 --workerIdleMemoryLimit=512MB",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "tdd",
    "test-driven-development",
    "mcp",
    "model-context-protocol",
    "ai-tools",
    "testing",
    "typescript"
  ],
  "author": "TDD MCP Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "lodash": "^4.17.21",
    "micromatch": "^4.0.5",
    "uuid": "^11.1.0",
    "yaml": "^2.3.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.7",
    "@types/micromatch": "^4.0.6",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0"
  },
  "files": [
    "dist",
    "templates",
    "best-practices",
    "skills"
  ],
  "bin": {
    "tdd-mcp-server": "./dist/server.js"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
